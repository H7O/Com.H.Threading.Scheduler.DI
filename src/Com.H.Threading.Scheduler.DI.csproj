<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Com.H.Threading.Scheduler.DI</AssemblyName>
    <RootNamespace>Com.H.Threading.Scheduler.DI</RootNamespace>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Version>11.0.0</Version>
    <Authors>Hussein Al Bayati</Authors>
    <Description>Dependency injection extension for Com.H.Threading.Scheduler API to facilitate easier usage for applications that utilize IHostBuilder services DI pipeline</Description>
    <Copyright>Hussein Al Bayati</Copyright>
    <PackageProjectUrl>https://github.com/H7O/Com.H.Threading.Scheduler.DI</PackageProjectUrl>
    <PackageIcon>128x128.jpg</PackageIcon>
    <PackageReadmeFile>nuget.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/H7O/Com.H.Threading.Scheduler.DI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Dependency Injection, Concurrency, Multi-threading, BackgroundService, Containerized</PackageTags>
    <PackageReleaseNotes>11.0.0

* New: a net11.0 build, for .NET 11. The net8.0, net9.0 and net10.0 builds stay. The major version
  is 11 because it follows the .NET generation.
* Now on Com.H.Threading.Scheduler 11.0.x, which changes what happens to a task whose handler
  throws: it is tried again after a pause instead of on every tick, and a task that used up its
  retry_attempts_on_error runs again at its next scheduled time. If you relied on a failing task
  being tried again every second, set sleep_on_error to your tick interval. The scheduler's notes
  list every change: https://www.nuget.org/packages/Com.H.Threading.Scheduler/11.0.0#releasenotes-body-tab
* Fixed: SchedulerServiceOptions.ValueProcessors had no effect. The processors are now used, and
  one with the name of a built-in processor replaces it.
* New: SchedulerServiceOptions.DefaultSleepOnError sets the pause for a failed task that has
  neither sleep_on_error nor an interval (the scheduler's default is 60 seconds).
* Dependencies: Com.H 11.0.x, and Microsoft.Extensions.DependencyInjection and
  Microsoft.Extensions.Options 10.0.11 or later (they were 8.0.0 or later).</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

  </PropertyGroup>

  <ItemGroup>
    <None Include="..\128x128.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Com.H" Version="[11.0.0, 11.1.0)" />
    <PackageReference Include="Com.H.Threading.Scheduler" Version="[11.0.0, 11.1.0)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
  </ItemGroup>

</Project>
